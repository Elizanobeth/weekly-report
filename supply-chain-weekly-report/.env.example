# 仅复制变量名，不要把真实密钥提交到Git。
DATA_SOURCE=excel
HOST=127.0.0.1
PORT=4173
EXCEL_FILE=outputs/excel-sync/周报模拟数据.xlsx

WPS_ACCESS_TOKEN=
WPS_FILE_ID=
WPS_SHEET_ID=

# 如果WPS开放平台启用了接口签名，再填写以下三项。
WPS_SIGNING_ENABLED=false
WPS_APP_ID=
WPS_APP_SECRET=

# 仅在非生产测试表执行写入验证时启用。
WPS_ALLOW_WRITE=NO
WPS_TEST_TEXT_FIELD=
WPS_TIMEOUT_MS=15000
